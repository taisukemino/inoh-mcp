# Port the MCP HTTP server listens on
PORT=3333

# Interface to bind. Use 0.0.0.0 when running in a container or behind a proxy.
HOST=127.0.0.1

# Externally reachable base URL of this server. Advertised to MCP clients in
# OAuth metadata. Defaults to http://HOST:PORT.
# PUBLIC_URL=https://mcp.inoh.app

# Supabase project URL. Must match the `iss` claim Supabase puts in user JWTs
# exactly (for local Supabase that is http://127.0.0.1:54321, not localhost).
SUPABASE_URL=http://127.0.0.1:54321

# Legacy JWT shared secret of the same project. Required while the project
# signs tokens with HS256 (prod today), and for `pnpm token:local`. Projects on
# asymmetric signing keys are verified via the JWKS and can leave this empty.
# Local: `supabase status -o env` -> JWT_SECRET. Prod: dashboard -> Project
# Settings -> JWT Keys.
SUPABASE_JWT_SECRET=
